{
  "name": "blowfish",
  "repo": "https://github.com/nunocoracao/blowfish.git",
  "branch": "main",
  "hugo": "hugo-0.167.exe",
  "featured_image_key": "featureimage",
  "skip": [
    "gallery.md"
  ],
  "config": {
    "theme": "blowfish",
    "defaultContentLanguage": "en",
    "enableEmoji": true,
    "buildDrafts": false,
    "buildFuture": false,
    "summaryLength": 45,
    "pagination": {
      "pagerSize": 10
    },
    "outputs": {
      "home": [
        "HTML",
        "RSS",
        "JSON"
      ]
    },
    "taxonomies": {
      "tag": "tags",
      "category": "categories",
      "author": "authors",
      "series": "series"
    }
  }
}
