{{- $pages := where site.RegularPages "Type" "posts" -}}
{{- $pages = where $pages "Params.hidden" nil -}}
{{- $pages = $pages.ByDate.Reverse -}}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
    <title>{{ site.Title }}</title>
    <link href="{{ site.BaseURL }}feed.xml" rel="self" />
    <link href="{{ site.BaseURL }}" />
    <updated>{{ (index $pages 0).Lastmod.Format "2006-01-02T15:04:05-07:00" }}</updated>
    <author>
        <name>Liam Shaw</name>
    </author>
    <id>{{ site.BaseURL }}</id>
{{- range $pages }}
    <entry>
        <title>{{ .Title }}</title>
        <author>
            <name>Liam Shaw</name>
        </author>
        <link href="{{ .Permalink }}"/>
        <id>{{ .Permalink }}</id>
        {{- with .Params.featured_image }}
        <media:content url="{{ site.BaseURL }}{{ . }}" medium="image" />
        {{- end }}

        <updated>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</updated>
            <summary type="html">
                <![CDATA[
                        {{- with .Params.featured_image }}
                        <img src="{{ site.BaseURL }}{{ . }}" alt="" />
                        {{- end }}
                    {{ partial "excerpt.html" . }}
                ]]>
            </summary>
        <content type="html">
            <![CDATA[
                    {{ .Content | safeHTML }}
            ]]>
        </content>
    </entry>
{{- end }}
</feed>
