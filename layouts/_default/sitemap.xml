{{- $pages := where site.RegularPages "Kind" "page" -}}
{{- $pages = sort $pages "Params.slug" -}}
<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="{{ site.BaseURL }}sitemap.xsl"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
<url>
<loc>{{ site.BaseURL }}</loc>
</url>
{{- range $pages }}
<url>
<loc>{{ .Permalink }}</loc>
<lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
{{- with .Params.featured_image }}
<image:image>
<image:loc>{{ site.BaseURL }}{{ . }}</image:loc>
<image:title><![CDATA[]]></image:title>
</image:image>
{{- end }}
{{- range findRE `src="[^"]*media/posts/[^"]+"` .Content }}
{{- $path := replaceRE `^src=".*?(media/posts/[^"]+)"$` "$1" . -}}
<image:image>
<image:loc>{{ site.BaseURL }}{{ $path }}</image:loc>
<image:title><![CDATA[]]></image:title>
</image:image>
{{- end }}
</url>
{{- end }}
</urlset>
