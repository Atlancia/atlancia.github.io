{{- /*
  The JSON Feed at /feed.json, the second address the site has always
  published. Same essays, same order, same summary as the Atom feed.
*/ -}}
{{- $site := hugo.Data.site -}}
{{- $root := strings.TrimSuffix "/" site.BaseURL -}}
{{- $pages := where site.RegularPages "Section" "posts" -}}
{{- $pages = $pages.ByDate.Reverse -}}
{{- $items := slice -}}
{{- range $pages -}}
  {{- $item := dict
    "id" .Permalink
    "url" .Permalink
    "title" .Title
    "summary" (partial "excerpt.html" . | plainify)
    "content_html" (.Content | safeHTML)
  -}}
  {{- with .Params.featureimage -}}
    {{- $item = merge $item (dict "image" (printf "%s/%s" $root .)) -}}
  {{- end -}}
  {{- $item = merge $item (dict
    "author" (dict "name" "Liam Shaw")
    "tags" (slice)
    "date_published" (.Date.Format "2006-01-02T15:04:05-07:00")
    "date_modified" (.Lastmod.Format "2006-01-02T15:04:05-07:00")
  ) -}}
  {{- $items = $items | append $item -}}
{{- end -}}
{{- $feed := dict
  "version" "https://jsonfeed.org/version/1"
  "title" $site.name
  "description" $site.description
  "home_page_url" $root
  "feed_url" (printf "%s/feed.json" $root)
  "user_comment" ""
  "icon" (printf "%s/%s" $root $site.logo)
  "author" (dict "name" "Liam Shaw")
  "items" $items
-}}
{{- $feed | jsonify (dict "indent" "    ") | safeHTML -}}
